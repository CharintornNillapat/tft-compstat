# Copy to .env.local and fill in. Never commit real values.
# Validated by src/lib/env.ts — each consumer checks only the variables it needs.

# Supabase → Project Settings → API.
# Legacy anon/service_role JWTs or the newer publishable/secret keys both work.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Riot — https://developer.riotgames.com
# A Personal API Key is recommended: development keys expire every 24h.
RIOT_API_KEY=
RIOT_GAME_NAME=
RIOT_TAG_LINE=
# Platform routing value, e.g. na1, euw1, kr, th2
RIOT_PLATFORM=

# Random strings, at least 16 characters (e.g. `openssl rand -hex 24`).
CRON_SECRET=
REVALIDATE_SECRET=
